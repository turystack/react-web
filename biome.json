{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": [
      "**/src/**/*",
      "**/vite.config.ts",
      "!**/*.css",
      "!**/src/shadcn"
    ]
  },
  "plugins": [
    {
      "includes": [
        "**/src/components/**/*.types.ts",
        "!**/src/components/button/button.types.ts",
        "!**/src/components/calendar/**",
        "!**/src/shadcn/**"
      ],
      "path": "./plugins/no-classname-type-member.grit"
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noLabelWithoutControl": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off"
      },
      "complexity": {
        "noBannedTypes": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useUniqueElementIds": "off"
      },
      "recommended": true,
      "style": {
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  }
}
