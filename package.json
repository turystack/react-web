{
	"name": "@turystack/react-web",
	"description": "TuryStack React web component library built with Base UI and shadcn patterns.",
	"private": false,
	"version": "1.0.0",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks/web.d.ts",
			"import": "./dist/hooks/web.js"
		},
		"./styles.css": "./dist/index.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"typecheck": "tsc --noEmit -p tsconfig.app.json",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"lint": "biome lint ./src ./tests",
		"format": "biome format --write ./src ./tests",
		"check": "biome check ./src ./tests",
		"check:fix": "biome check --write ./src ./tests",
		"prepack": "pnpm run build"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/turystack/react-web.git"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@fontsource-variable/geist": "^5.2.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"react-day-picker": "^9.14.0",
		"react-imask": "^7.6.1",
		"react-infinite-scroll-component": "^7.2.0",
		"react-phone-number-input": "^3.4.16",
		"react-resizable-panels": "^4.9.0",
		"recharts": "3.8.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0",
		"usehooks-ts": "3.1.1",
		"vaul": "^1.1.2"
	},
	"peerDependencies": {
		"@turystack/react-hooks": "^1.0.0",
		"@turystack/react-icons": "^1.0.0",
		"react": ">=19",
		"react-dom": ">=19",
		"tailwindcss": ">=4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/react": "^16.3.2",
		"@turystack/react-hooks": "^1.0.0",
		"@turystack/react-icons": "^1.0.0",
		"@types/node": "^24.12.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@typescript/typescript6": "^6.0.2",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^28.1.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"rolldown": "1.1.5",
		"shadcn": "4.13.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-plugin-dts": "5.0.3",
		"vitest": "^4.1.10"
	}
}
